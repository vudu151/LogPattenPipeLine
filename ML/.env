# Cấu hình của package ML (mô hình phát hiện bất thường).
# Dùng chung image với package spark để mô hình được huấn luyện bằng đúng bản scikit-learn mà job 2 dùng.
ML_IMAGE=log-pattern-pipeline/spark:3.5.3
REDIS_HOST=redis                 # cây mẫu Drain đã warm-up (đọc khi đánh giá)
REDIS_PORT=6379

# Năm package chung một project Compose (log-pattern-pipeline) để dùng chung volume và tên container;
# khi chạy riêng một package, không coi container của package khác là "mồ côi".
COMPOSE_IGNORE_ORPHANS=true
