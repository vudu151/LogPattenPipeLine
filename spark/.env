# Cấu hình của package spark (bước Transform): cụm Spark và hai kho phụ trợ của các job.
# Lưu ý: tài khoản PostgreSQL app/app và database logs cũng được dùng trong mã nguồn các job, Grafana và
# bảng điều khiển; đổi ở đây thì phải đổi ở các nơi đó.
SPARK_IMAGE=log-pattern-pipeline/spark:3.5.3
SPARK_MASTER_UI_PORT=8080        # http://localhost:8080
SPARK_MASTER_PORT=7077
SPARK_JOB1_UI_PORT=4040          # giao diện job 1
SPARK_JOB2_UI_PORT=4041          # giao diện job 2
SPARK_WORKER_REPLICAS=2
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=logs

# Năm package chung một project Compose (log-pattern-pipeline) để dùng chung volume và tên container;
# khi chạy riêng một package, không coi container của package khác là "mồ côi".
COMPOSE_IGNORE_ORPHANS=true
