# Cấu hình của package log_producer (bước Extract): Kafka nhận log thô từ Log Producer.
KAFKA_IMAGE=apache/kafka:3.9.0
KAFKA_HOST_PORT=29092            # cổng Kafka cho tiến trình chạy trên máy host (Log Producer, Alert System)
KAFKA_LOG_RETENTION_HOURS=24     # Kafka giữ dữ liệu thô bao lâu
KAFKA_NUM_PARTITIONS=4
KAFKA_UI_PORT=8090               # giao diện Kafka UI: http://localhost:8090

# Năm package chung một project Compose (log-pattern-pipeline) để dùng chung volume và tên container;
# khi chạy riêng một package, không coi container của package khác là "mồ côi".
COMPOSE_IGNORE_ORPHANS=true
