# Cấu hình của package grafana (dashboard).
GRAFANA_IMAGE=grafana/grafana:11.3.0
GRAFANA_PORT=3000                # http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PLUGINS=grafana-clickhouse-datasource

# Năm package chung một project Compose (log-pattern-pipeline) để dùng chung volume và tên container;
# khi chạy riêng một package, không coi container của package khác là "mồ côi".
COMPOSE_IGNORE_ORPHANS=true
