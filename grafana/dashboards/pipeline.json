      "uid": "ch-logs"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT toStartOfInterval(processed_time, INTERVAL 10 second) AS time, source, count() AS dong FROM logs.log_events WHERE $__timeFilter(processed_time) GROUP BY time, source ORDER BY time",
     "refId": "A"
    }
   ],
