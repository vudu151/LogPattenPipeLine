# Cấu hình của package clickhouse (bước Load): kho dữ liệu.
# Lưu ý: tài khoản app/app và database logs cũng được dùng trong init.sql, Grafana và bảng điều khiển;
# đổi ở đây thì phải đổi ở các nơi đó.
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
CLICKHOUSE_DB=logs
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=app
CLICKHOUSE_HTTP_PORT=8123        # HTTP: truy vấn, Grafana, bảng điều khiển (http://localhost:8123/play)
CLICKHOUSE_NATIVE_PORT=19000     # giao thức native

# Năm package chung một project Compose (log-pattern-pipeline) để dùng chung volume và tên container;
# khi chạy riêng một package, không coi container của package khác là "mồ côi".
COMPOSE_IGNORE_ORPHANS=true
